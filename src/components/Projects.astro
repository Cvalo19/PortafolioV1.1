---
//icons skills
import HTML5 from '../components/icons/Html5.astro';
import Tailwind from '../components/icons/Tailwind.astro';
import Blender from '../components/icons/Blender.astro';
import AstroIcon from '../components/icons/AstroIcon.astro';
import Reactjs from '../components/icons/Reactjs.astro';
import AfterIcon from '../components/icons/AfetIcon.astro';
import SolidWorks from '../components/icons/SolidWorks.astro';
import CSS from '../components/icons/CSS.astro';
import illustrator from '../components/icons/illustrator.astro';
import Sketchup from './icons/Sketchup.astro';
import tm from './icons/tm.astro';
import Corel from './icons/Corel.astro';
import express from './icons/express.astro';
import sequelize from './icons/sequelize.astro';
//Buttons
import LinkButton from '../components/LinkButtonSelf.astro';
import ShowButton from '../components/icons/ShowButton.astro';
import GitHub from '../components/icons/GitHub.astro'


const TAGS = 
  {
    HTML:{
      name: 'HTML5',
      class: 'bg-gray-400/85 text-gray-800 dark:text-white dark:bg-gray-800',
      icon: HTML5,
    },
    TAILWIND:{
      name: 'Tailwind CSS',
      class: 'bg-gray-400/85 text-gray-800 dark:text-white dark:bg-gray-800',
      icon: Tailwind,
    },
    BLENDER:{
      name: 'Blender',
      class: 'bg-gray-400/85 text-gray-800 dark:text-white dark:bg-gray-800',
      icon: Blender,
    },
    ASTROTAG:{
      name: 'Astro',
      class: 'bg-gray-400/85 text-gray-800 dark:text-white dark:bg-gray-800',
      icon: AstroIcon,
    },
    REACTJS:{
      name: 'ReactJs',
      class: 'bg-gray-400/85 text-gray-800 dark:text-white dark:bg-gray-800',
      icon: Reactjs,
    },
    CSS:{
      name: 'CSS',
      class: 'bg-gray-400/85 text-gray-800 dark:text-white dark:bg-gray-800',
      icon: CSS,
    },
    AFTER:{
      name: 'After Effects',
      class: 'bg-gray-400/85 text-gray-800 dark:text-white dark:bg-gray-800',
      icon: AfterIcon,
    },
    SOLID:{
      name: 'SolidWorks',
      class: 'bg-gray-400/85 text-gray-800 dark:text-white dark:bg-gray-800',
      icon: SolidWorks,
    },
    SKETCHUP:{
      name: 'SketchUp',
      class: 'bg-gray-400/85 text-gray-800 dark:text-white dark:bg-gray-800',
      icon: Sketchup,
    },
    TM:{
      name: 'Twinmotion',
      class: 'bg-gray-400/85 text-gray-800 dark:text-white dark:bg-gray-800',
      icon: tm,
    },
    ILLUSTRATOR:{
      name: 'Illustrator',
      class: 'bg-gray-400/85 text-gray-800 dark:text-white dark:bg-gray-800',
      icon: illustrator,
    },
    COREL:{
      name: 'CorelDraw',
      class: 'bg-gray-400/85 text-gray-800 dark:text-white dark:bg-gray-800',
      icon: Corel,
    },
    EXPRESS:{
      name: 'Express.js',
      class: 'bg-gray-400/85 text-gray-800 dark:text-white dark:bg-gray-800',
      icon: express,
    },
    SEQUELIZE:{
      name: 'Sequelize',
      class: 'bg-gray-400/85 text-gray-800 dark:text-white dark:bg-gray-800',
      icon: sequelize,
    },
  }

const PROJECTS = [
  
      {
      title: 'Sistema de Monitoreo remoto',
      description: 'Proyecto de ingeniería orientado al diseño de soluciones para monitoreo remoto, integrando modelado 3D, prototipado y documentación para fabricación.',
      link:'projects/halcon',
      image:'/projects/projects02.jpg',
      tags:[ TAGS.SOLID, TAGS.COREL, TAGS.AFTER],
      area: 'Ingenieria',
    },
    {
      title: 'Diseño de estructuras para eventos',
      description: 'Desarrollo de espacios publicitarios y experiencias visuales para marcas, equilibrando creatividad, identidad visual y viabilidad técnica.',
      link:'projects/goodone',
      image:'/projects/projects04.jpg',
      tags:[ TAGS.SKETCHUP, TAGS.TM, TAGS.ILLUSTRATOR, TAGS.BLENDER],
      area: 'Diseño comercial',
    },
    {
      title: 'Plataforma web Valhalla',
      description: 'Plataforma web desarrollada para la administración y publicación de perfiles profesionales, diseñada para ofrecer una experiencia intuitiva y facilitar la conexión entre clientes y prestadores de servicios.',
      link:'projects/valhalla',
      github:'https://github.com/christianvalo19',
      image:'/projects/projects03.jpg',
      tags:[ TAGS.ASTROTAG,TAGS.TAILWIND, TAGS.REACTJS, TAGS.EXPRESS, TAGS.SEQUELIZE],
      area: 'Desarrollo web',
    },

   
  ]

---


<div class="flex flex-col gap-y-16">
  <h2 class="mt-2 text-lg text-gray-700 dark:text-gray-400">Una selección de proyectos que representan mi evolución profesional, desde soluciones de ingeniería y diseño técnico hasta desarrollo web y experiencias digitales.</h2>
  {
    PROJECTS.map(({ image, title, description, tags, link, github, area }) => (
    <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
  <div class="w-full md:w-1/2">
    <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
      <img 
          alt = {`imagen del proyecto ` + title }="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105" loading="lazy" src={image} />
    </div>
  </div>

  <div class="w-full md:w-1/2 md:max-w-lg">
  <p class="uppercase tracking-[0.2em] text-xs font-semibold dark:text-violet-300 text-violet-800/90">
  {area}
  </p>
    <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
      {title}
    </h3>
    <div class="flex flex-wrap mt-2">
      <ul class="flex flex-row mb-2 gap-x-2">
          {tags.map((tag) => (
            <li>
              <span
                class={`flex gap-x-1.5 rounded-full text-[10px] ${tag.class} py-[3px] px-2 `}
              >
                <tag.icon class="size-3" />
                {tag.name}
              </span>
            </li>
          ))}
        </ul>
      <div class="mt-2 text-gray-700 dark:text-gray-400">{description}</div>
      <footer class="flex items-end justify-start mt-4 gap-x-4">
          {github && (
            <LinkButton href={github}>
              <GitHub class="size-6" />
              Codigo
              
            </LinkButton>
          )}
          {link && (
            <LinkButton href={link}>
              <ShowButton class="size-4" />
              Ver proyecto
            </LinkButton>
          )}
        </footer>
    </div>
  </div>
</article>
    ))
  }
</div>



