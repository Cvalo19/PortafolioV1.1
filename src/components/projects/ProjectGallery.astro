---
interface Props {
    images: string[];
}

const { images } = Astro.props;
---

<section class="max-w-6xl mx-auto px-6 py-16">

<div class="grid md:grid-cols-2 gap-6">

{
images.map(image => (

<img
src={image}
class="rounded-xl shadow-lg hover:scale-[1.02] transition"
/>

))
}

</div>

</section>