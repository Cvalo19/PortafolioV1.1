---
interface Props {
  title?: string;
}

const {
  title = "Lecciones del proyecto",
} = Astro.props;
---

<section class="max-w-3xl mx-auto py-20">

    <h2
        class="text-3xl font-bold text-gray-800 dark:text-white">

        {title}

    </h2>

    <div
        class="mt-6 text-gray-600 dark:text-gray-400 leading-8">

        <slot />

    </div>

</section>