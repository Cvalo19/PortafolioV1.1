---
interface Props{

title:string;

description:string;

image:string;

year?:string;
reverse?: boolean;

}

const{

title,
description,
image,
year

}=Astro.props;
---

<article
class="relative grid md:grid-cols-[80px_1fr] gap-8">

    <!-- Columna izquierda -->

    <div
    class="relative flex justify-center">

        <!-- Línea -->

        <div
        class="absolute top-0 bottom-0 w-px dark:bg-neutral-700 bg-neutral-300">
        </div>

        <!-- Punto -->

        <div
        class="relative z-10 w-5 h-5 rounded-full dark:bg-[#ddd] border-4 dark:border-[#121212] bg-neutral-600 border-[#7a7676]">
        </div>

    </div>

    <!-- Contenido -->

    <div>

        {
        year &&(

        <span
        class="text-sm dark:text-neutral-500 text-neutral-700">

        {year}

        </span>

        )
        }

        <h3
        class="mt-2 text-2xl font-bold text-gray-800 dark:text-white">

        {title}

        </h3>

        <p
        class="mt-4 text-gray-600 dark:text-gray-400 leading-relaxed">

        {description}

        </p>

        <img

        src={image}

        alt={title}

        class="w-full mt-8 rounded-2xl shadow-xl"

        />

    </div>

</article>