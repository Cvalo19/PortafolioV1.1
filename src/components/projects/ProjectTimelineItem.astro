---
interface Props{

title:string;

description:string;

image:string;

year?:string;
reverse?: boolean;

}

const{

title,
description,
image,
year

}=Astro.props;
---

<article
class="relative grid md:grid-cols-[80px_1fr] gap-8">

    <!-- Columna izquierda -->

    <div
    class="relative flex justify-center">

        <!-- Línea -->

        <div
        class="absolute top-0 bottom-0 w-px bg-neutral-700">
        </div>

        <!-- Punto -->

        <div
        class="relative z-10 w-5 h-5 rounded-full bg-[#ddd] border-4 border-[#121212]">
        </div>

    </div>

    <!-- Contenido -->

    <div>

        {
        year &&(

        <span
        class="text-sm text-neutral-500">

        {year}

        </span>

        )
        }

        <h3
        class="mt-2 text-2xl font-bold text-white">

        {title}

        </h3>

        <p
        class="mt-4 text-neutral-300 leading-relaxed">

        {description}

        </p>

        <img

        src={image}

        alt={title}

        class="mt-8 rounded-2xl shadow-xl"

        />

    </div>

</article>