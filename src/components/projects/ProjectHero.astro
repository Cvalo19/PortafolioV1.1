---
interface Props {
  image: string;
  title: string;
  area: string;
  description: string;
}

const {
  image,
  title,
  area,
  description,
} = Astro.props;
---

<section class="max-w-6xl mx-auto px-6 py-16">

  <img
    src={image}
    alt={title}
    class="w-full h-90 rounded-2xl shadow-xl object-cover [object-position:center_20%] mx-auto"
  />

  <p class="mt-8 uppercase tracking-widest text-sm dark:text-violet-400 text-violet-600">
    {area}
  </p>

  <h1 class="mt-2 text-5xl font-bold text-gray-800 dark:text-gray-200">
    {title}
  </h1>

  <p class="mt-6 text-xl text-gray-600 dark:text-gray-400 max-w-3xl">
    {description}
  </p>

</section>