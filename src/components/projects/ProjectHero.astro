---
interface Props {
  image: string;
  title: string;
  area: string;
  description: string;
}

const {
  image,
  title,
  area,
  description,
} = Astro.props;
---

<section class="max-w-6xl mx-auto px-6 py-16">

  <img
    src={image}
    alt={title}
    class="w-full rounded-2xl shadow-xl object-cover"
  />

  <p class="mt-8 uppercase tracking-widest text-sm text-violet-400">
    {area}
  </p>

  <h1 class="mt-2 text-5xl font-bold">
    {title}
  </h1>

  <p class="mt-6 text-xl text-gray-600 dark:text-gray-400 max-w-3xl">
    {description}
  </p>

</section>